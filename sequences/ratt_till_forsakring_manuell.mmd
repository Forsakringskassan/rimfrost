sequenceDiagram

    participant VAH
    participant RTF_regel_manuell
    participant handlaggning
    participant OUL
    participant SID
    participant portal
    participant folkbokford
    participant arbetsgivare

rect rgb(70, 120, 160)
    note over VAH,arbetsgivare: Ramverkslogik
end

rect rgb(70, 120, 160)
    VAH ->> RTF_regel_manuell: Kafka: RegelRequestMessage (handlaggningId, AktivitetsId)

    note over RTF_regel_manuell: Hämta handläggningsinformation
    RTF_regel_manuell ->> handlaggning: GET /handlaggning/handlaggningId}
    handlaggning -->> RTF_regel_manuell: (handlaggning)

    note over RTF_regel_manuell: Ny operativ uppgift behövs
    RTF_regel_manuell ->> OUL: POST /uppgifter (handlaggningId, regel: "VAH_RTF", url, roll, status_topic, ...)
    note over OUL: Skapa ny operativ uppgift
    OUL -->> RTF_regel_manuell: (uppgiftId, handlaggningId, status)

    note over RTF_regel_manuell: Uppdatera handläggningsinformation med ny uppgiftsinformation
    RTF_regel_manuell ->> handlaggning: PUT /handlaggning/{handlaggningId}/
    handlaggning -->> RTF_regel_manuell: (handlaggning)
end

    note over portal: Handläggare listar sina uppgifter
    portal ->> OUL: GET /uppgifter/handlaggare/{handlaggareId}

alt Handläggare har SID-rättigheter
    note over OUL: returnerar alla handläggarens uppgifter
else Handläggare saknar SID-rättigheter
    loop alla uppgifter kopplade till handläggaren
        OUL ->> handlaggning: GET /handlaggning/{handlaggningId}
        handlaggning -->> OUL: (handlaggning inkl. individer)

        OUL ->> SID: POST /sid/status (individer)
        SID -->> OUL: (skyddad identitet: true/false)
    end
    note over OUL: returnerar uppgifter där ingen individ har skyddad identitet
end

    OUL -->> portal: (uppgifter)

    note over portal: Handläggare vill hämta ny uppgift
    portal ->> OUL: POST /uppgifter/handlaggare/{handlaggareId}

    OUL ->> handlaggning: GET /handlaggning/{handlaggningId}
    handlaggning -->> OUL: (handlaggning inkl. individer)

    OUL ->> SID: POST /sid/status (individer)
    SID -->> OUL: (skyddad identitet: false)

    note over OUL: tilldela uppgift till handläggare

rect rgb(70, 120, 160)
    OUL ->> RTF_regel_manuell: Kafka: OperativtUppgiftslagerStatusMessage (uppgiftsId, status=Tilldelad)

    note over RTF_regel_manuell: Spara uppdaterad uppgift i handläggningsinformation
    RTF_regel_manuell ->> handlaggning: PUT /handlaggning/{handlaggningId}/
    handlaggning -->> RTF_regel_manuell: (handlaggning)

    OUL -->> portal: (operativUppgift inkl url)

    note over portal: Tilldelad uppgift visas för handläggare
    note over portal: url renderar tilldelad uppgift

    portal ->> RTF_regel_manuell: GET /regel/rtf-manuell/{handlaggningId}

    note over RTF_regel_manuell: Hämta handläggningsinformation
    RTF_regel_manuell ->> handlaggning: GET /handlaggning/{handlaggningId}
    handlaggning -->> RTF_regel_manuell: (handlaggning)

    note over RTF_regel_manuell: Uppdatera handläggningsinformation med nytt underlag om handläggarens läsning av information
    RTF_regel_manuell ->> handlaggning: PUT /handlaggning/{handlaggningId}
    handlaggning -->> RTF_regel_manuell: (handlaggning)
end

    note over RTF_regel_manuell: Hämta infon som behövs för regeln
    note over RTF_regel_manuell: individId hämtas från handläggningsinformation

    RTF_regel_manuell ->> SID: POST /sid/status (individer)
    SID -->> RTF_regel_manuell: (skyddad identitet)

alt skyddad identitet: false
    RTF_regel_manuell ->> folkbokford: GET /folkbokford/info/{personnummer}
    folkbokford -->> RTF_regel_manuell: person (namn, kön, adress ...)

    RTF_regel_manuell ->> arbetsgivare: GET /arbetsgivare/info/{personnummer}
    arbetsgivare -->> RTF_regel_manuell: anställningsinfo (period, orgnummer, orgnamn)

    RTF_regel_manuell -->> portal: (all info som frontend_url behöver)
else skyddad identitet: true
    RTF_regel_manuell ->> OUL: POST /uppgifter/{uppgiftId}/unassign
    OUL -->> RTF_regel_manuell: (status)
    RTF_regel_manuell -->> portal: denied
end

    note over RTF_regel_manuell: TODO hantering av handläggare med SID-permissions ?
    note over RTF_regel_manuell: Uppdatera handläggningsinformation

rect rgb(70, 120, 160)
    RTF_regel_manuell ->> handlaggning: PUT /handlaggning/{handlaggningId}
    handlaggning -->> RTF_regel_manuell: (handlaggning)
end

    note over portal: Handläggare utför manuell uppgift

rect rgb(70, 120, 160)
    portal ->> RTF_regel_manuell: PATCH /regel/rtf-manuell/{handlaggningId} (info om uppgift och resultat)
end

    note over RTF_regel_manuell: Uppdatera handläggningsinformation

rect rgb(70, 120, 160)
    RTF_regel_manuell ->> handlaggning: PUT /handlaggning/{handlaggningId}
    handlaggning -->> RTF_regel_manuell: (handlaggning)

    RTF_regel_manuell -->> portal: OK
end

    note over portal: Handläggare avslutar uppgift

rect rgb(70, 120, 160)
    portal ->> RTF_regel_manuell: POST /regel/rtf-manuell/{handlaggningId}/done
    RTF_regel_manuell -->> portal: OK
    RTF_regel_manuell ->> OUL: POST /uppgifter/{uppgiftId}/close (anledning=Avslutad)
    OUL -->> RTF_regel_manuell: (status)

    note over RTF_regel_manuell: Uppdatera status för uppgift som del av handläggningsinformation
    RTF_regel_manuell ->> handlaggning: PUT /handlaggning/{handlaggningId}
    handlaggning -->> RTF_regel_manuell: (handlaggning)
end

    note over RTF_regel_manuell: Eventuell cleanup som regeln kräver
    note over RTF_regel_manuell: sendRegelResponse(handlaggningId, Utfall=JA)

rect rgb(70, 120, 160)
    RTF_regel_manuell ->> VAH: Kafka: RegelResponseMessage (handlaggningId, utfall)
end
